# Server
PORT=3000
NODE_ENV=development

# JWT - CHANGE IN PRODUCTION
JWT_SECRET=your-secret-key-min-32-characters
JWT_EXPIRE=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# CORS
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
```

---

